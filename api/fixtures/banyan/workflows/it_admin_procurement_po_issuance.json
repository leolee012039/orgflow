{
  "workflow_name": "Procurement and Purchase Order Issuance",
  "opportunity_id": "it_admin_procurement_po_issuance",
  "department": "IT & Administration",
  "fields": [
    {
      "name": "item",
      "label": "Item",
      "type": "text",
      "options": []
    },
    {
      "name": "client_project",
      "label": "Client project",
      "type": "text",
      "options": []
    },
    {
      "name": "estimated_cost",
      "label": "Estimated cost in Indian rupees excluding GST",
      "type": "number",
      "options": []
    },
    {
      "name": "business_reason",
      "label": "Business reason",
      "type": "text",
      "options": []
    }
  ],
  "required_fields": [
    "item",
    "client_project",
    "estimated_cost",
    "business_reason"
  ],
  "rules": [
    {
      "id": "rule_quotes_required",
      "when": {
        "field": "estimated_cost",
        "op": ">",
        "value": 50000
      },
      "source": "For purchases above Rs. 50,000/- the IT Executive obtains three written quotations from registered vendors."
    }
  ],
  "steps": [
    {
      "id": "step_ai_review",
      "type": "ai_review",
      "actor": "orgflow_ai",
      "only_if": null,
      "also_if": null,
      "check": "Verify that item, client project, estimated cost, and business reason are provided.",
      "on_fail": "human_review"
    },
    {
      "id": "step_obtain_quotations",
      "type": "task",
      "actor": "it_executive",
      "only_if": "rule_quotes_required",
      "also_if": null,
      "check": null,
      "on_fail": null
    },
    {
      "id": "step_select_vendor_issue_po",
      "type": "task",
      "actor": "administration_manager",
      "only_if": null,
      "also_if": null,
      "check": null,
      "on_fail": null
    },
    {
      "id": "step_notify_requester",
      "type": "notification",
      "actor": "requester",
      "only_if": null,
      "also_if": null,
      "check": null,
      "on_fail": null
    }
  ],
  "unresolved_actors": [],
  "amount_tiers": [],
  "starts_from": "Delivery",
  "hands_to": null,
  "output": "issued purchase order",
  "explanation": "This workflow handles procurement operations transferred from Delivery according to Section 4 of the Purchase Policy. When estimated cost exceeds Rs. 50,000, the IT Executive obtains three written quotations, followed by the Administration Manager selecting the vendor and issuing the purchase order.",
  "upstream_id": "delivery_purchase_request_approval"
}
