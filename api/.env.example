# Gemini on Vertex AI (run `gcloud auth application-default login` first)
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash

# Sign-in is on unless this is 0. Use 0 only for local development.
ORGFLOW_REQUIRE_AUTH=0
FIREBASE_PROJECT_ID=your-project-id

# Daily limits per Cloud Run instance (approximate)
ORGFLOW_DAILY_LIMIT=30
ORGFLOW_STAGE_LIMIT=300
ORGFLOW_ANON_RUN_LIMIT=300

# Comma-separated web origins allowed to call the API (localhost:3000 is always allowed).
# Cloud Run refuses to start without it.
ALLOWED_ORIGINS=

# Optional
# GEMINI_TIMEOUT_S=90
# GEMINI_HEDGE_AFTER_S=20
# ORGFLOW_SAMPLE_LIVE=1   # read the sample live instead of its saved answers
# ORGFLOW_DEV_CACHE=1     # cache Gemini answers locally during development
# ORGFLOW_GEMINI_OFF=1    # emergency switch: pause every live Gemini call (docs/RUNBOOK.md)
