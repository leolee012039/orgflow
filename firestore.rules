rules_version = '2';

// A company workspace belongs to the person who created it. They can add built
// workflows and cases, share it read-only (shared == true), unshare or delete it. Nobody
// else can change it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{workspaceId} {
      function signedIn() {
        return request.auth != null;
      }
      function isOwner() {
        return signedIn() && request.auth.uid == resource.data.owner;
      }

      allow read: if resource.data.shared == true || isOwner();
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.shared == false;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['built', 'cases', 'shared', 'updatedAt'])
        && request.resource.data.shared is bool;
      allow delete: if isOwner();
    }
  }
}
