rules_version = '2';

// A company workspace belongs to the person who created it. They can add built
// workflows, cases and decisions, share it read-only (shared == true), unshare or delete it. Nobody
// else can change it. A shared workspace opens for anyone with its link (get), but only the
// owner can list workspaces, so nobody can browse what others shared.
//
// Every write is checked for the fields the web app writes, their types and their sizes, the
// same way on create and on update: a workspace can't be turned into something that breaks the
// page for the people it is shared with. Limits match the app: 30 workflows (10 departments x 3),
// 30 cases, 50 decisions.
service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{workspaceId} {
      function signedIn() {
        return request.auth != null;
      }
      function isOwner() {
        return signedIn() && request.auth.uid == resource.data.owner;
      }
      // The parts the owner keeps changing after the analysis
      function validWork(d) {
        return d.built is map && d.built.size() <= 30
          && (!('cases' in d) || (d.cases is list && d.cases.size() <= 30))
          && (!('decisions' in d) || (d.decisions is list && d.decisions.size() <= 50))
          && d.shared is bool;
      }
      // A whole workspace, as the web app writes it
      function validWorkspace(d) {
        return d.keys().hasOnly(['organization', 'departmentMap', 'plan', 'company', 'documents', 'built',
                                 'cases', 'decisions', 'analyzedAt', 'sample', 'owner', 'shared',
                                 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['organization', 'departmentMap', 'plan', 'company', 'documents', 'built',
                              'analyzedAt', 'sample', 'owner', 'shared'])
          && d.organization is map && d.departmentMap is map && d.plan is map && d.documents is map
          && d.company is string && d.company.size() <= 200
          && ((d.analyzedAt is string && d.analyzedAt.size() <= 40) || d.analyzedAt is timestamp)
          && d.sample is bool
          && validWork(d);
      }

      allow get: if resource.data.shared == true || isOwner();
      allow list: if isOwner();
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.shared == false
        && validWorkspace(request.resource.data);
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['built', 'cases', 'decisions', 'shared', 'updatedAt'])
        && validWork(request.resource.data);
      allow delete: if isOwner();
    }
  }
}
