# The API (local: uvicorn on port 8080)
NEXT_PUBLIC_API_BASE=http://localhost:8080

# Firebase web app settings. Leave empty to run without accounts (then set ORGFLOW_REQUIRE_AUTH=0 on the API).
NEXT_PUBLIC_FIREBASE_API_KEY=
# The address Google's sign-in window shows. <project>.firebaseapp.com works anywhere; the site itself
# (orgflowai.web.app) reads better, once https://orgflowai.web.app/__/auth/handler is an authorized redirect URI
# of the Firebase web client (Google Cloud console, APIs & Services, Credentials).
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
